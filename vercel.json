{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat.js"
    },
    {
      "source": "/api/feedback",
      "destination": "/api/feedback.js"
    },
    {
      "source": "/api/referral",
      "destination": "/api/referral.js"
    },
    {
      "source": "/api/unsubscribe",
      "destination": "/api/unsubscribe.js"
    },
    {
      "source": "/api/sync-ticker",
      "destination": "/api/sync-ticker.js"
    },
    {
      "source": "/api/send-nudges",
      "destination": "/api/send-nudges.js"
    },
    {
      "source": "/terms",
      "destination": "/api/legal.js?doc=terms"
    },
    {
      "source": "/privacy",
      "destination": "/api/legal.js?doc=privacy"
    },
    {
      "source": "/refund",
      "destination": "/api/legal.js?doc=refund"
    },
    {
      "source": "/data-retention",
      "destination": "/api/legal.js?doc=data-retention"
    }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 120
    },
    "api/forecast.js": {
      "maxDuration": 120
    },
    "api/feedback.js": {
      "maxDuration": 10
    },
    "api/referral.js": {
      "maxDuration": 10
    },
    "api/unsubscribe.js": {
      "maxDuration": 10
    },
    "api/sync-ticker.js": {
      "maxDuration": 30
    },
    "api/send-nudges.js": {
      "maxDuration": 60
    },
    "api/legal.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/sync-ticker",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/send-nudges",
      "schedule": "30 1 1 * *"
    }
  ]
}
